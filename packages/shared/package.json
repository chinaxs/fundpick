{
  "name": "@project/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "前后端共享的类型定义、常量与工具函数",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "type-check": "tsc -p tsconfig.build.json --noEmit"
  },
  "devDependencies": {
    "typescript": "~6.0.0"
  }
}

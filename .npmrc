# 依赖链接方式：pnpm 默认严格隔离，避免幽灵依赖
# 如需调试可临时改为 hoisted
shamefully-hoist=false
strict-peer-dependencies=false
auto-install-peers=true
# 由 workspace 协议统一管理本地包版本
link-workspace-packages=true

# 镜像源：国内可改为 https://registry.npmmirror.com 加速
registry=https://registry.npmjs.org/
# store 独立放在用户目录，避免与项目目录的权限策略冲突
store-dir=~/.pnpm-store-study

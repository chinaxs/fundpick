# ===== 应用 =====
APP_NAME=study-api
APP_ENV=development
DEBUG=true

# ===== 服务 =====
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
# 允许跨域的前端地址，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5174,http://localhost:3000

# ===== 安全 =====
# 生产环境务必替换：openssl rand -hex 32
SECRET_KEY=change-me-in-production-please-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== MySQL =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=study_app
MYSQL_PASSWORD=change-me
MYSQL_DB=test_study
# 连接池
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ===== 日志 =====
LOG_LEVEL=INFO

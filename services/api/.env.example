# ===== 应用 =====
APP_NAME=fundpick-api
APP_ENV=development
DEBUG=true

# ===== 服务 =====
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
# 允许跨域的前端地址，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5174,http://localhost:3000

# ===== 安全 =====
# 生产环境务必替换：openssl rand -hex 32
SECRET_KEY=change-me-in-production-please-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== MySQL =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=fundpick_app
MYSQL_PASSWORD=change-me
MYSQL_DB=fundpick
# 连接池
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ===== AI（LangChain / LangGraph / deepagents）=====
# 不配置也能启动，/api/v1/ai/* 会返回 503 并提示缺什么
AI_ENABLED=false
OPENAI_API_KEY=
# 任意 OpenAI 兼容端点均可：
#   OpenAI      https://api.openai.com/v1
#   DeepSeek    https://api.deepseek.com/v1
#   通义千问     https://dashscope.aliyuncs.com/compatible-mode/v1
#   本地 vLLM    http://127.0.0.1:8001/v1
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2
# 智能体单次请求最多推理轮数，防死循环
AI_MAX_ITERATIONS=12
AI_TIMEOUT=60

# ===== 日志 =====
LOG_LEVEL=INFO
# 关闭后只在控制台输出，容器部署建议保持 true 并挂载 logs 目录
LOG_FILE_ENABLED=true

# ===== 采集调度 =====
# 进程内调度器按 sync_schedules 表触发，多 worker 靠数据库互斥去重
SYNC_SCHEDULER_ENABLED=true
SYNC_SCHEDULER_INTERVAL_SECONDS=60

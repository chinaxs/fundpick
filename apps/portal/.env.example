# 后端真实地址：SSR 直连 + Nitro 反向代理的目标
# 容器部署时改成 http://api:8000/api/v1 之类
NUXT_API_BASE=http://127.0.0.1:8000/api/v1

# 浏览器侧基址。保持相对路径 /api/v1（同源），由上面的代理转发，
# 不要改回绝对地址，否则会重新引入 CORS 问题（见 docs/adr/0007）。
NUXT_PUBLIC_API_BASE=/api/v1

# 页脚外部入口
NUXT_PUBLIC_API_DOCS_URL=http://127.0.0.1:8000/docs/portal
NUXT_PUBLIC_ADMIN_URL=http://localhost:5174
